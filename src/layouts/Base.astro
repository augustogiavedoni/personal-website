---
import '../styles/global.css';
import { site, about } from '../data/site';
import { localizePath, locales, splitLocale, type Locale } from '../i18n';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  lang?: Locale;
  type?: 'website' | 'article';
  published?: Date;
  /** Path to a 1200×630 preview image; defaults to the site card. */
  image?: string;
  /**
   * Real translations of this page, by language. Defaults to the same path in every language.
   * Posts pass only the versions that exist.
   */
  alternates?: Partial<Record<Locale, string>>;
  /** Play the boot intro (home page only). */
  boot?: boolean;
}

const { path } = splitLocale(Astro.url.pathname);
const {
  title,
  lang = 'en',
  description = about[lang].description,
  type = 'website',
  published,
  image = '/og.png',
  boot = false,
  alternates = Object.fromEntries(locales.map((code) => [code, localizePath(path, code)])),
} = Astro.props;

const fullTitle = title ? `${title} · ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);

// The language switch always has somewhere to go: the translation, or that language's writing index.
const switchTargets = Object.fromEntries(
  locales.map((code) => [code, alternates[code] ?? localizePath('/writing/', code)]),
) as Record<Locale, string>;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      Object.entries(alternates).map(([code, href]) => (
        <link rel="alternate" hreflang={code} href={new URL(href, Astro.site)} />
      ))
    }
    {alternates.en && <link rel="alternate" hreflang="x-default" href={new URL(alternates.en, Astro.site)} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="color-scheme" content="light dark" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.name} · RSS`}
      href={localizePath('/rss.xml', lang)}
    />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={lang === 'es' ? 'es_AR' : 'en_US'} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title ?? site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@agvdni" />

    <!-- Apply the saved or system theme before first paint, so dark-mode visitors never see a white flash. -->
    <script is:inline>
      (function () {
        var theme;
        try {
          theme = localStorage.getItem('theme');
        } catch (e) {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    {
      boot && (
        <script is:inline>
          (function () {
            // Boot on every home page load, but never with reduced motion. Decided before paint.
            if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
              document.documentElement.classList.add('booting');
            }
          })();
        </script>
      )
    }
  </head>
  <body>
    <a class="skip" href="#main">{lang === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>
    <slot name="before" />
    <div class="column">
      <Header locale={lang} switchTargets={switchTargets} />
      <main id="main">
        <slot />
      </main>
      <Footer locale={lang} />
    </div>
  </body>
</html>
