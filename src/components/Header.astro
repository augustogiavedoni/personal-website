---
import { site } from '../data/site';
import { localizePath, splitLocale, t, type Locale } from '../i18n';
import ThemeToggle from './ThemeToggle.astro';
import LanguageSwitch from './LanguageSwitch.astro';

interface Props {
  locale: Locale;
  switchTargets: Record<Locale, string>;
}

const { locale, switchTargets } = Astro.props;
const strings = t(locale);
const onWriting = splitLocale(Astro.url.pathname).path.startsWith('/writing');
---

<header class="header">
  <a class="mark mono" href={localizePath('/', locale)} aria-label={`${site.name}, ${strings.home}`}
    >{site.initials}</a
  >
  <div class="nav">
    <nav aria-label="Primary">
      <a
        class="link mono"
        href={localizePath('/writing/', locale)}
        aria-current={onWriting ? 'page' : undefined}>{strings.writing}</a
      >
    </nav>
    <LanguageSwitch locale={locale} targets={switchTargets} />
    <ThemeToggle locale={locale} />
  </div>
</header>

<style>
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 24px;
  }

  .mark {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-height: var(--target);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .link {
    display: inline-flex;
    align-items: center;
    height: var(--target);
    padding: 0 12px;
    font-size: 12px;
    color: var(--muted);
    text-decoration: none;
  }

  @media (max-width: 380px) {
    .link {
      padding: 0 8px;
    }
  }

  .link[aria-current='page'],
  .link:hover {
    color: var(--fg);
  }
</style>
