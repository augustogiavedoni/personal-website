---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="footer mono">
  <span>© {year} {site.name}</span>
  <span>{site.city}</span>
</footer>

<style>
  .footer {
    margin-top: clamp(96px, 12vw, 160px);
    padding-top: 20px;
    border-top: 1px solid var(--rule);
    display: flex;
    justify-content: space-between;
    gap: 16px;
    font-size: 11px;
    color: var(--muted);
  }
</style>
