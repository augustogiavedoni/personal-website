---
// Contribution heatmap across all GitHub accounts, from src/data/contributions.json.
// Stage 5 adds the build-time script that fills that file with real data.
import SectionHeading from '../SectionHeading.astro';
import contributions from '../../data/contributions.json';
import { formatNumber, t, type Locale } from '../../i18n';

interface Props {
  index: number;
  locale: Locale;
}

interface Day {
  date: string; // YYYY-MM-DD
  count: number;
}

const { index, locale } = Astro.props;
const strings = t(locale);
const days = contributions.days as Day[];
const total = days.reduce((sum, day) => sum + day.count, 0);

const level = (n: number) => (n === 0 ? 0 : n <= 3 ? 1 : n <= 6 ? 2 : n <= 10 ? 3 : 4);

// Rows are weekdays (Sunday first), so pad the first column up to the first day's weekday.
const firstWeekday = days.length > 0 ? new Date(`${days[0].date}T00:00:00Z`).getUTCDay() : 0;
const padding = Array.from({ length: firstWeekday });
const weeks = Math.ceil((firstWeekday + days.length) / 7);
const formatted = formatNumber(total, locale);
---

<section class="section" aria-labelledby="activity">
  <SectionHeading id="activity" label={strings.activity} index={index} />
  <p class="total"><strong>{formatted}</strong> {strings.contributions}</p>
  <div class="scroller">
    <div
      class="grid"
      role="img"
      aria-label={strings.heatmapLabel(formatted)}
      style={`--weeks: ${weeks}`}
    >
      {padding.map(() => <span class="cell empty" />)}
      {
        days.map((day) => (
          <span class={`cell l${level(day.count)}`} title={`${day.count} on ${day.date}`} />
        ))
      }
    </div>
  </div>
  <div class="legend mono" aria-hidden="true">
    <span>{strings.less}</span>
    <span class="cell l0"></span>
    <span class="cell l1"></span>
    <span class="cell l2"></span>
    <span class="cell l3"></span>
    <span class="cell l4"></span>
    <span>{strings.more}</span>
  </div>
</section>

<style>
  .total {
    margin: 0;
    font-size: 16px;
  }

  .total strong {
    font-weight: 600;
  }

  /* Right-to-left scrolling keeps the latest weeks in view on narrow screens. */
  .scroller {
    overflow-x: auto;
    direction: rtl;
  }

  .grid {
    direction: ltr;
    width: max-content;
    display: grid;
    grid-template-columns: repeat(var(--weeks), 9px);
    grid-template-rows: repeat(7, 9px);
    grid-auto-flow: column;
    gap: 3px;
  }

  .cell {
    display: inline-block;
    width: 9px;
    height: 9px;
    border-radius: 2px;
  }

  .empty {
    background: transparent;
  }

  .l0 {
    background: var(--heat-0);
  }
  .l1 {
    background: var(--heat-1);
  }
  .l2 {
    background: var(--heat-2);
  }
  .l3 {
    background: var(--heat-3);
  }
  .l4 {
    background: var(--heat-4);
  }

  .legend {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 4px;
    font-size: 11px;
    color: var(--muted);
  }

  .legend span:first-child {
    margin-right: 4px;
  }

  .legend span:last-child {
    margin-left: 4px;
  }
</style>
