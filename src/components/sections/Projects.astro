---
import SectionHeading from '../SectionHeading.astro';
import { links, projects } from '../../data/site';

interface Props {
  index: number;
}

const { index } = Astro.props;
const github = links.find((link) => link.label === 'GitHub');
---

<section class="section" aria-labelledby="projects">
  <SectionHeading id="projects" label="Projects" index={index} />
  <ul class="list">
    {
      projects.map((project) => (
        <li>
          <a class="card" href={project.href}>
            <span class="top">
              <span class="name">{project.name}</span>
              <span class="tag mono">{project.tag}</span>
            </span>
            <span class="desc">{project.description}</span>
          </a>
        </li>
      ))
    }
  </ul>
  {
    github && (
      <a class="more mono" href={github.href}>
        All repositories on GitHub ↗
      </a>
    )
  }
</section>

<style>
  .list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 26px;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-decoration: none;
  }

  .card:hover .name {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
  }

  .name {
    font-size: 16px;
    font-weight: 500;
  }

  .tag {
    flex-shrink: 0;
    font-size: 11px;
    color: var(--muted);
  }

  .desc {
    font-size: 15px;
    line-height: 1.5;
    color: var(--muted);
  }

  .more {
    align-self: flex-start;
    font-size: 12px;
    text-underline-offset: 4px;
  }
</style>
