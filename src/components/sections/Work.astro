---
import SectionHeading from '../SectionHeading.astro';
import { work } from '../../data/site';
import { t, type Locale } from '../../i18n';

interface Props {
  index: number;
  locale: Locale;
}

const { index, locale } = Astro.props;
const strings = t(locale);
---

<section class="section" aria-labelledby="work">
  <SectionHeading id="work" label={strings.work} index={index} />
  <div class="timeline">
    <div class="line" aria-hidden="true"></div>
    <ol class="list">
      {
        work.map((job) => (
          <li class="item">
            <div class="logo">
              <div class="tile mono" role="img" aria-label={job.company}>
                {job.mark}
              </div>
              {job.current && <span class="dot" aria-hidden="true" />}
            </div>
            <div class="body">
              <div class="text">
                <span class="company">
                  <span>{job.company}</span>
                  {job.current && <span class="now mono">{strings.now}</span>}
                </span>
                <span class="title">{job.title}</span>
              </div>
              <span class="year mono">{job.start}</span>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .timeline {
    position: relative;
  }

  .line {
    position: absolute;
    left: 20px;
    top: 22px;
    bottom: 22px;
    width: 1px;
    background: var(--rule);
  }

  .list {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .item {
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr);
    gap: 18px;
    align-items: center;
  }

  .logo {
    position: relative;
    width: 42px;
    height: 42px;
  }

  .tile {
    width: 42px;
    height: 42px;
    border-radius: 10px;
    border: 1px solid var(--rule);
    background: var(--tile);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .dot {
    position: absolute;
    right: -3px;
    bottom: -3px;
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 0 0 2px var(--bg);
  }

  .body {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    min-width: 0;
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .company {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.35;
  }

  .now {
    font-size: 11px;
    font-weight: 400;
    color: var(--muted);
  }

  .title {
    font-size: 15px;
    line-height: 1.4;
    color: var(--muted);
  }

  .year {
    flex-shrink: 0;
    font-size: 12px;
    color: var(--muted);
  }
</style>
