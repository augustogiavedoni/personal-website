---
// Shows the current theme; clicking switches it and remembers the choice.
// The theme itself is applied before first paint by the inline script in Base.astro.
---

<button type="button" class="toggle mono" data-theme-toggle aria-label="Switch to dark theme">
  <svg class="icon sun" aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
  <svg class="icon moon" aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path>
  </svg>
  <span class="name light">Light</span>
  <span class="name dark">Dark</span>
</button>

<style>
  .toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: var(--target);
    padding: 0 14px;
    background: transparent;
    color: var(--fg);
    border: 1px solid var(--rule);
    border-radius: 999px;
    font-size: 12px;
    cursor: pointer;
  }

  .moon,
  .dark {
    display: none;
  }

  :global(:root[data-theme='dark']) .moon,
  :global(:root[data-theme='dark']) .dark {
    display: inline;
  }

  :global(:root[data-theme='dark']) .sun,
  :global(:root[data-theme='dark']) .light {
    display: none;
  }
</style>

<script>
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const system = window.matchMedia('(prefers-color-scheme: dark)');

  function saved(): string | null {
    try {
      return localStorage.getItem('theme');
    } catch {
      return null;
    }
  }

  function apply(theme: 'light' | 'dark') {
    root.dataset.theme = theme;
    button?.setAttribute(
      'aria-label',
      theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme',
    );
  }

  apply(root.dataset.theme === 'dark' ? 'dark' : 'light');

  button?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    apply(next);
    try {
      localStorage.setItem('theme', next);
    } catch {
      // Storage blocked (private mode): the choice lasts for this page only.
    }
  });

  // Follow the system setting until the visitor makes a choice of their own.
  system.addEventListener('change', (event) => {
    if (!saved()) apply(event.matches ? 'dark' : 'light');
  });
</script>
