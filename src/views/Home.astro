---
import Base from '../layouts/Base.astro';
import { site, about } from '../data/site';
import contributions from '../data/contributions.json';
import { getPosts, toSummary } from '../lib/posts';
import type { Locale } from '../i18n';
import LatestWriting from '../components/sections/LatestWriting.astro';
import Projects from '../components/sections/Projects.astro';
import Activity from '../components/sections/Activity.astro';
import Work from '../components/sections/Work.astro';
import Contact from '../components/sections/Contact.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const posts = (await getPosts(locale)).map(toSummary);

// Activity stays hidden until real contribution data exists (stage 5), so the site never shows fake numbers.
const showActivity = contributions.days.length > 0;

// Section numbers follow the sections actually shown.
let n = 0;
const next = () => ++n;
const idx = {
  writing: next(),
  projects: next(),
  activity: showActivity ? next() : 0,
  work: next(),
  contact: next(),
};
---

<Base lang={locale}>
  <section class="intro">
    <img
      class="photo"
      src={site.photo.src}
      alt={site.photo.alt}
      width={site.photo.size}
      height={site.photo.size}
    />
    <h1>{site.name}</h1>
    <p class="role mono">{site.role} · {site.city}</p>
    <p class="bio">{about[locale].bio}</p>
  </section>

  <LatestWriting index={idx.writing} posts={posts} locale={locale} />
  <Projects index={idx.projects} locale={locale} />
  {showActivity && <Activity index={idx.activity} locale={locale} />}
  <Work index={idx.work} locale={locale} />
  <Contact index={idx.contact} locale={locale} />
</Base>

<style>
  .intro {
    padding-top: clamp(72px, 11vw, 152px);
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .photo {
    width: 72px;
    height: 72px;
    margin-bottom: 10px;
    border-radius: 999px;
    border: 1px solid var(--rule);
    background: var(--tile);
    object-fit: cover;
  }

  h1 {
    margin: 0;
    font-size: clamp(34px, 4.2vw, 46px);
    line-height: 1.05;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .role {
    margin: 0;
    font-size: 13px;
    color: var(--muted);
  }

  .bio {
    margin: 0;
    max-width: 34em;
    font-size: 18px;
    line-height: 1.6;
  }
</style>
