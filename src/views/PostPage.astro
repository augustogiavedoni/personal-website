---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getTranslation, isoDate, postHref, readingTime, type Post } from '../lib/posts';
import { localizePath, t } from '../i18n';
import { links } from '../data/site';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const locale = post.data.lang;
const strings = t(locale);
const { Content } = await render(post);
const minutes = readingTime(post.body);
const x = links.find((link) => link.label === 'X');

// hreflang and the language switch point at the translation only when one exists.
const translation = await getTranslation(post);
const alternates = {
  [locale]: postHref(post),
  ...(translation ? { [translation.data.lang]: postHref(translation) } : {}),
};
const writingHref = localizePath('/writing/', locale);
---

<Base
  title={post.data.title}
  description={post.data.description}
  lang={locale}
  alternates={alternates}
  type="article"
  published={post.data.date}
  image={`/og/${post.id}.png`}
>
  <article>
    <header class="head">
      <a class="back mono" href={writingHref}>← {strings.writing}</a>
      <h1>{post.data.title}</h1>
      <p class="meta mono">
        <time datetime={isoDate(post.data.date)}>{isoDate(post.data.date)}</time>
        · {strings.minRead(minutes)}
        {post.data.draft && <span> · {strings.draftNotice}</span>}
      </p>
    </header>

    <div class="prose">
      <Content />
    </div>

    <footer class="end mono">
      <a href={writingHref}>← {strings.allWriting}</a>
      {x && <a class="muted" href={x.href}>{strings.replyOnX} ↗</a>}
    </footer>
  </article>
</Base>

<style>
  article {
    padding-top: clamp(64px, 9vw, 120px);
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--rule);
  }

  .back {
    align-self: flex-start;
    font-size: 12px;
    color: var(--muted);
    text-decoration: none;
  }

  h1 {
    margin: 0;
    font-size: clamp(30px, 3.6vw, 40px);
    line-height: 1.12;
    font-weight: 600;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .meta {
    margin: 0;
    font-size: 12px;
    color: var(--muted);
  }

  .end {
    margin-top: 64px;
    padding-top: 20px;
    border-top: 1px solid var(--rule);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    font-size: 12px;
  }

  .end a {
    text-underline-offset: 4px;
  }

  .end .muted {
    color: var(--muted);
  }

  /* Post body. Markdown output has no classes, so these reach into it with :global. */
  .prose {
    padding-top: 36px;
    font-size: 18px;
    line-height: 1.7;
  }

  .prose > :global(* + *) {
    margin-top: 24px;
  }

  .prose > :global(:first-child) {
    margin-top: 0;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(pre),
  .prose :global(blockquote),
  .prose :global(h2),
  .prose :global(h3) {
    margin-bottom: 0;
  }

  .prose :global(h2) {
    margin-top: 48px;
    font-size: 24px;
    line-height: 1.3;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .prose :global(h3) {
    margin-top: 40px;
    font-size: 19px;
    line-height: 1.4;
    font-weight: 600;
  }

  .prose :global(a) {
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }

  .prose :global(strong) {
    font-weight: 600;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 22px;
  }

  .prose :global(li + li) {
    margin-top: 8px;
  }

  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.83em;
    background: var(--code);
    border-radius: 4px;
    padding: 2px 6px;
  }

  .prose :global(pre) {
    padding: 20px 22px;
    background: var(--code);
    border: 1px solid var(--rule);
    border-radius: 8px;
    overflow-x: auto;
    font-size: 14px;
    line-height: 1.65;
  }

  .prose :global(pre code) {
    font-size: inherit;
    background: none;
    padding: 0;
    border-radius: 0;
  }

  .prose :global(blockquote) {
    margin-left: 0;
    margin-right: 0;
    padding: 4px 0 4px 24px;
    border-left: 2px solid var(--fg);
    font-size: 20px;
    line-height: 1.55;
    font-style: italic;
  }

  .prose :global(blockquote p) {
    margin: 0;
  }

  .prose :global(img) {
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
    border-radius: 8px;
  }

  .prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--rule);
    margin-block: 48px;
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
    display: block;
    overflow-x: auto;
  }

  .prose :global(th),
  .prose :global(td) {
    text-align: left;
    padding: 8px 12px 8px 0;
    border-bottom: 1px solid var(--rule);
  }
</style>
